generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String          @id @default(uuid())
  username       String          @unique
  passwordHash   String
  role           String // OPERATOR, ENGINEER, SUPERVISOR, ADMIN
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  eventLogs      EventLog[]
  commandRecords CommandRecord[]
}

model Mission {
  id                 String      @id @default(uuid())
  shipName           String
  objective          String
  hullSection        String
  status             String // DRAFT, READY, RUNNING, PAUSED, COMPLETED, ABORTED
  progressPercentage Int         @default(0)
  startedAt          DateTime?
  pausedAt           DateTime?
  completedAt        DateTime?
  abortedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  stateVersion       Int         @default(0)
  cutRecords         CutRecord[]
  eventLogs          EventLog[]
}

model CutRecord {
  id             String    @id @default(uuid())
  missionId      String
  name           String?
  type           String    // OPEN_PATH, CLOSED_LOOP
  status         String    // PLANNED, READY, RUNNING, PENDING, COMPLETED, ABORTED, FAILED
  photoPlanJson  String?   // JSON of photo-plan coordinates
  normalizedJson String?   // JSON of normalized coordinates
  worldJson      String?   // JSON of world/digital-twin coordinates
  panelId        String?
  commandId      String?
  plannedAt      DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  abortedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  stateVersion   Int       @default(0)
  mission        Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model EventLog {
  id        String   @id @default(uuid())
  category  String
  severity  String
  message   String
  timestamp DateTime @default(now())
  missionId String?
  userId    String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CommandRecord {
  id         String   @id @default(uuid())
  commandId  String   @unique
  type       String
  status     String // PENDING, ACKNOWLEDGED, REJECTED, FAILED, TIMED_OUT
  operatorId String
  missionId  String?
  source     String
  payload    String
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [operatorId], references: [id])
}

model RuntimeState {
  id                   String   @id @default("singleton")
  systemMode           String   @default("SIMULATED")
  positionX            Float    @default(0)
  positionY            Float    @default(0)
  positionZ            Float    @default(0)
  armY                 Float    @default(0)
  armX                 Float    @default(0)
  torchEnabled         Boolean  @default(false)
  electromagnetEnabled Boolean  @default(false)
  emergencyActive      Boolean  @default(false)
  activeMissionId      String?
  lastCommandId        String?
  stateVersion         Int      @default(0)
  updatedAt            DateTime @updatedAt
}

model TelemetryRecord {
  id                  String   @id @default(uuid())
  timestamp           DateTime @default(now())
  robotId             String   @default("ROBO-1")
  source              String
  mode                String   // LIVE, SIMULATED, HISTORICAL

  // Robot Power
  powerVoltage        Float
  powerCurrent        Float

  // IMU
  imuAccelX           Float
  imuAccelY           Float
  imuAccelZ           Float
  imuGyroX            Float
  imuGyroY            Float
  imuGyroZ            Float
  imuTiltAngle        Float

  // Motors
  motorCurrentLeft    Float
  motorCurrentRight   Float
  motorTempLeft       Float
  motorTempRight      Float

  // Hardware / Actuators
  electromagnetCurrent Float
  electromagnetEnabled Boolean @default(false)
  armExtensionY       Float
  armExtensionX       Float
  vibrationLevel      Float
  torchStatus         String

  // Gas
  oxyPressurePsi      Float
  oxyFlowRate         Float
  acePressurePsi      Float
  aceFlowRate         Float

  // Environment
  envTemperatureC     Float
  envHumidity         Float
  envAtmosphericPressure Float
  envWindSpeed        Float
  envRain             Boolean
  envVisibility       String
  envO2Percentage     Float
  envCoPpm            Float
  envCo2Ppm           Float
  envCombustibleGasLel Float

  // Position
  positionX           Float @default(0)
  positionY           Float @default(0)
  positionZ           Float @default(0)
  
  // Health/Faults
  overallHealth       String @default("GOOD")

  createdAt           DateTime @default(now())
  
  @@index([timestamp])
  @@index([mode])
}
